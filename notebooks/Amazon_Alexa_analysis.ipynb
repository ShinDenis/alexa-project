    "def bars_count_show(orientation=0, offset=5, fontsize=10, show_count=True, show_percent=True):\n",
    "    '''\n",
    "    Добавляет подписи с количеством и % для sns.countplot.\n",
    "    \n",
    "    Parameters:\n",
    "    - orientation (str): 0 — вертикальный, 1 — горизонтальный\n",
    "    - padding (int): смещение текста от столбца\n",
    "    - fontsize (int): размер шрифта\n",
    "    - show_percent (bool): показывать ли процент от общего количества\n",
    "    '''\n",
    "    ax = plt.gca() # получаем \n",
    "\n",
    "    if orientation == 0:\n",
    "        total = sum(p.get_height() for p in ax.patches)\n",
    "        \n",
    "        for p in ax.patches:\n",
    "            x = p.get_x() + p.get_width() / 2\n",
    "            y = p.get_height()\n",
    "            percent = (y / total) * 100 if total > 0 else 0\n",
    "            count = f'{int(y)}'\n",
    "            \n",
    "            label = ''\n",
    "            if show_count:\n",
    "                label = count\n",
    "            if show_percent:\n",
    "                label += f' \\n ({percent:.2f}%)' \n",
    "            \n",
    "            plt.text(\n",
    "                x,\n",
    "                y + offset,\n",
    "                label,\n",
    "                ha='center',\n",
    "                va='bottom',\n",
    "                fontsize=fontsize\n",
    "            )\n",
    "            \n",
    "    elif orientation == 1:\n",
    "        \n",
    "        total = sum(p.get_width() for p in ax.patches)\n",
    "        \n",
    "        for p in ax.patches:\n",
    "            x = p.get_width()\n",
    "            y = p.get_y() + p.get_height() / 2\n",
    "            percent = (x / total) * 100 if total > 0 else 0\n",
    "            count = f'{int(x)}'\n",
    "           \n",
    "            label = ''\n",
    "            if show_count:\n",
    "                label = count\n",
    "            if show_percent:\n",
    "                label += f'\\n({percent:.2f}%)'\n",
    "            \n",
    "            plt.text(\n",
    "                x,\n",
    "                y,\n",
    "                label,\n",
    "                va='center',\n",
    "                ha='left',\n",
    "                fontsize=fontsize\n",
    "            )"
   ]
  },
