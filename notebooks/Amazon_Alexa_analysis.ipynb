   "source": [
    "def positive_feedback(data, var, figsize=(12, 5), sort_by='positive', ascending=False):\n",
    "    \"\"\"\n",
    "    Строит график с процентом положительных/отрицательных отзывов по категориальному признаку var\n",
    "    в стиле stacked bar + линия количества.\n",
    "    \"\"\"\n",
    "    grouped = data.groupby(var, observed=True)['feedback'].agg(['mean', 'count']).reset_index()\n",
    "    grouped['positive_pct'] = grouped['mean'] * 100\n",
    "    grouped['negative_pct'] = 100 - grouped['positive_pct']\n",
    "    grouped = grouped.round(2)\n",
    "    \n",
    "    if sort_by in ['positive', 'negative']:\n",
    "        grouped = grouped.sort_values(by=f\"{sort_by}_pct\", ascending=ascending)\n",
    "    \n",
    "    labels = grouped[var].astype(str).tolist()\n",
    "    x = np.arange(len(labels))\n",
    "    width = 0.6\n",
    "    \n",
    "    fig, ax1 = plt.subplots(figsize=figsize)\n",
    "    \n",
    "    # stacked bar\n",
    "    ax1.bar(x, grouped['positive_pct'], width, label='Positive', color='steelblue')\n",
    "    ax1.bar(x, grouped['negative_pct'], width, bottom=grouped['positive_pct'], label='Negative', color='salmon')\n",
    "    \n",
    "    # подписи процентов (важно использовать enumerate после сортировки!)\n",
    "    for i, row in grouped.reset_index(drop=True).iterrows():\n",
    "        ax1.text(i, row['positive_pct'] / 2, f\"{row['positive_pct']:.1f}%\",\n",
    "                 ha='center', va='center', fontsize=9, color='white', fontweight='bold')\n",
    "        ax1.text(i, row['positive_pct'] + row['negative_pct'] / 2, f\"{row['negative_pct']:.1f}%\",\n",
    "                 ha='center', va='center', fontsize=9, color='white', fontweight='bold')\n",
    "    \n",
    "    ax1.set_xticks(x)\n",
    "    ax1.set_xticklabels(labels, rotation=45, ha='right')\n",
    "    ax1.set_xlabel(var)\n",
    "    ax1.set_ylabel('%')\n",
    "    ax1.set_ylim(0, 100)\n",
    "    ax1.legend(loc='lower left')\n",
    "    \n",
    "    # вторая ось — количество\n",
    "    ax2 = ax1.twinx()\n",
    "    ax2.plot(x, grouped['count'], color='orange', marker='o', linewidth=2, linestyle='--', label='review count')\n",
    "    ax2.legend(loc='upper right')\n",
    "    \n",
    "    plt.title(f'Positive feedback by {var}')\n",
    "    plt.tight_layout()\n",
    "    plt.show()\n",
    "    \n",
    "    print(grouped)"
   ]
  },
